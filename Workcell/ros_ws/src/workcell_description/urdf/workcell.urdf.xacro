<?xml version="1.0"?>
<robot name="workcell" xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- Layout placeholders, NOT measured. Units: meters / radians.
     Origin = plate center at table surface. +X = AR4 -> JetCobot, +Z up.
     To update the layout, change the properties below; the macros do the math. -->

<!-- ===================== Properties (edit these) ===================== -->

<!-- Base plate -->
<xacro:property name="plate_x" value="1.0"/>
<xacro:property name="plate_y" value="0.7"/>
<xacro:property name="plate_t" value="0.012"/>   <!-- thickness -->

<!-- Robot positions (center of each robot's footprint) -->
<xacro:property name="ar4_x"   value="-0.3"/>
<xacro:property name="ar4_y"   value="0.0"/>
<xacro:property name="ar4_zone_size" value="0.26"/>

<xacro:property name="cobot_x" value="0.3"/>
<xacro:property name="cobot_y" value="0.0"/>
<xacro:property name="cobot_yaw" value="${pi}"/>  <!-- faces the AR4 -->
<xacro:property name="cobot_zone_size" value="0.18"/>

<!-- Insert fixture: holds the part. Cobot places, AR4 presses. -->
<xacro:property name="fixture_x" value="0.1"/>
<xacro:property name="fixture_y" value="0.0"/>
<xacro:property name="fixture_size_x" value="0.12"/>
<xacro:property name="fixture_size_y" value="0.08"/>
<xacro:property name="fixture_size_z" value="0.03"/>

<!-- Insert tray: cobot picks inserts here. -->
<xacro:property name="tray_x" value="0.3"/>
<xacro:property name="tray_y" value="-0.2"/>
<xacro:property name="tray_size_x" value="0.1"/>
<xacro:property name="tray_size_y" value="0.06"/>
<xacro:property name="tray_size_z" value="0.015"/>

<!-- Tool changer dock (AR4 only). Slots are spaced along X. -->
<xacro:property name="dock_x" value="-0.3"/>
<xacro:property name="dock_y" value="0.25"/>
<xacro:property name="dock_size_x" value="0.2"/>
<xacro:property name="dock_size_y" value="0.06"/>
<xacro:property name="dock_size_z" value="0.1"/>
<xacro:property name="slot_spacing" value="0.1"/>

<xacro:property name="zone_t" value="0.001"/>     <!-- zone marker thickness -->

<!-- ===================== Materials ===================== -->
<material name="gray">              <color rgba="0.5 0.5 0.5 1"/></material>
<material name="blue">              <color rgba="0 0 1 1"/></material>
<material name="orange">            <color rgba="1 0.5 0 1"/></material>
<material name="yellow">            <color rgba="1 0.9 0 1"/></material>
<material name="red_transparent">   <color rgba="1 0 0 0.4"/></material>
<material name="green_transparent"> <color rgba="0 1 0 0.4"/></material>

<!-- ===================== Macros ===================== -->

<!-- A box resting on the plate. Its frame is at the box center, so the joint
     lifts it by plate_t + size_z/2. collision:=false for markers that aren't
     physical objects. -->
<xacro:macro name="box_on_plate" params="name size_x size_y size_z x y material collision:=true">
    <link name="${name}">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><box size="${size_x} ${size_y} ${size_z}"/></geometry>
            <material name="${material}"/>
        </visual>
        <xacro:if value="${collision}">
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry><box size="${size_x} ${size_y} ${size_z}"/></geometry>
            </collision>
        </xacro:if>
    </link>
    <joint name="plate_to_${name}" type="fixed">
        <parent link="plate"/>
        <child link="${name}"/>
        <origin xyz="${x} ${y} ${plate_t + size_z/2}" rpy="0 0 0"/>
    </joint>
</xacro:macro>

<!-- An empty named frame (no geometry) that code and MoveIt target by name. -->
<xacro:macro name="frame" params="name parent xyz rpy:='0 0 0'">
    <link name="${name}"/>
    <joint name="${parent}_to_${name}" type="fixed">
        <parent link="${parent}"/>
        <child link="${name}"/>
        <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
</xacro:macro>

<!-- ===================== Cell ===================== -->

<link name="world"/>

<link name="plate">
    <visual>
        <origin xyz="0 0 ${plate_t/2}" rpy="0 0 0"/>
        <geometry><box size="${plate_x} ${plate_y} ${plate_t}"/></geometry>
        <material name="gray"/>
    </visual>
    <collision>
        <origin xyz="0 0 ${plate_t/2}" rpy="0 0 0"/>
        <geometry><box size="${plate_x} ${plate_y} ${plate_t}"/></geometry>
    </collision>
</link>

<joint name="world_to_plate" type="fixed">
    <parent link="world"/>
    <child link="plate"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
</joint>

<!-- Objects on the plate -->
<xacro:box_on_plate name="tool_changer_dock"
    size_x="${dock_size_x}" size_y="${dock_size_y}" size_z="${dock_size_z}"
    x="${dock_x}" y="${dock_y}" material="blue"/>

<xacro:box_on_plate name="insert_fixture"
    size_x="${fixture_size_x}" size_y="${fixture_size_y}" size_z="${fixture_size_z}"
    x="${fixture_x}" y="${fixture_y}" material="orange"/>

<xacro:box_on_plate name="insert_tray"
    size_x="${tray_size_x}" size_y="${tray_size_y}" size_z="${tray_size_z}"
    x="${tray_x}" y="${tray_y}" material="yellow"/>

<!-- Robot zone markers (visual only, robots stand on them) -->
<xacro:box_on_plate name="ar4_zone"
    size_x="${ar4_zone_size}" size_y="${ar4_zone_size}" size_z="${zone_t}"
    x="${ar4_x}" y="${ar4_y}" material="red_transparent" collision="false"/>

<xacro:box_on_plate name="cobot_zone"
    size_x="${cobot_zone_size}" size_y="${cobot_zone_size}" size_z="${zone_t}"
    x="${cobot_x}" y="${cobot_y}" material="green_transparent" collision="false"/>

<!-- Robot mount frames: on the plate surface, where each robot URDF attaches -->
<xacro:frame name="ar4_mount"   parent="plate" xyz="${ar4_x} ${ar4_y} ${plate_t}"/>
<xacro:frame name="cobot_mount" parent="plate" xyz="${cobot_x} ${cobot_y} ${plate_t}" rpy="0 0 ${cobot_yaw}"/>

<!-- Target frames: on the top surface of their object, so they follow it -->
<xacro:frame name="insert_target" parent="insert_fixture"    xyz="0 0 ${fixture_size_z/2}"/>
<xacro:frame name="insert_pick"   parent="insert_tray"       xyz="0 0 ${tray_size_z/2}"/>
<xacro:frame name="tool_slot_1"   parent="tool_changer_dock" xyz="${-slot_spacing/2} 0 ${dock_size_z/2}"/>
<xacro:frame name="tool_slot_2"   parent="tool_changer_dock" xyz="${slot_spacing/2} 0 ${dock_size_z/2}"/>

</robot>
