<?xml version="1.0" ?>
<robot name="workcell">

<!-- Layout placeholders, NOT measured. Units: meters / radians.
     Origin = plate center at table surface. +X = AR4 -> JetCobot, +Z up.
     Boxes: frame at the box center (visual origin 0 0 0),
            joint z = 0.012 (plate top) + half the box height. -->

<!-- Link Definitions -->
<link name="world">
</link>

<link name="plate">
    <visual>
        <geometry>
        <box size="1 0.7 0.012"/>
        </geometry>
        <origin xyz="0 0 0.006" rpy="0 0 0"/>
        <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
        </material>
    </visual>
</link>

<link name="toolChangerDock">
    <visual>
        <geometry>
        <box size="0.2 0.06 0.1"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <material name="blue">
        <color rgba="0 0 1 1"/>
        </material>
    </visual>
</link>

<!-- Insert fixture: holds the part. Cobot places, AR4 presses. 120 x 80 x 30 mm -->
<link name="insert_fixture">
    <visual>
        <geometry>
        <box size="0.12 0.08 0.03"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <material name="orange">
        <color rgba="1 0.5 0 1"/>
        </material>
    </visual>
</link>

<!-- Insert tray: cobot picks inserts here. 100 x 60 x 15 mm -->
<link name="insert_tray">
    <visual>
        <geometry>
        <box size="0.1 0.06 0.015"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <material name="yellow">
        <color rgba="1 0.9 0 1"/>
        </material>
    </visual>
</link>

<!-- Robot zone markers: thin see-through squares (1 mm) showing each robot's footprint -->
<link name="ar4_zone">
    <visual>
        <geometry>
        <box size="0.26 0.26 0.001"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <material name="red_transparent">
        <color rgba="1 0 0 0.4"/>
        </material>
    </visual>
</link>

<link name="cobot_zone">
    <visual>
        <geometry>
        <box size="0.18 0.18 0.001"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <material name="green_transparent">
        <color rgba="0 1 0 0.4"/>
        </material>
    </visual>
</link>

<!-- Named frames (no geometry). Code and MoveIt target these by name. -->
<link name="ar4_mount"/>
<link name="cobot_mount"/>
<link name="insert_target"/>
<link name="insert_pick"/>
<link name="tool_slot_1"/>
<link name="tool_slot_2"/>

<!-- Joint Definitions -->
<joint name="world_to_plate" type="fixed">
    <parent link="world"/>
    <child link="plate"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
</joint>

<!-- z = 0.012 + 0.1/2 -->
<joint name="plate_to_toolChangerDock" type="fixed">
    <parent link="plate"/>
    <child link="toolChangerDock"/>
    <origin xyz="-0.3 0.25 0.062" rpy="0 0 0"/>
</joint>

<!-- z = 0.012 + 0.03/2 -->
<joint name="plate_to_insert_fixture" type="fixed">
    <parent link="plate"/>
    <child link="insert_fixture"/>
    <origin xyz="0.1 0 0.027" rpy="0 0 0"/>
</joint>

<!-- z = 0.012 + 0.015/2 -->
<joint name="plate_to_insert_tray" type="fixed">
    <parent link="plate"/>
    <child link="insert_tray"/>
    <origin xyz="0.3 -0.2 0.0195" rpy="0 0 0"/>
</joint>

<!-- z = 0.012 + 0.001/2 -->
<joint name="plate_to_ar4_zone" type="fixed">
    <parent link="plate"/>
    <child link="ar4_zone"/>
    <origin xyz="-0.3 0 0.0125" rpy="0 0 0"/>
</joint>

<joint name="plate_to_cobot_zone" type="fixed">
    <parent link="plate"/>
    <child link="cobot_zone"/>
    <origin xyz="0.3 0 0.0125" rpy="0 0 0"/>
</joint>

<!-- Robot mount frames: on the plate surface where each robot URDF will attach.
     Cobot is turned 180 deg about Z so it faces the AR4. -->
<joint name="plate_to_ar4_mount" type="fixed">
    <parent link="plate"/>
    <child link="ar4_mount"/>
    <origin xyz="-0.3 0 0.012" rpy="0 0 0"/>
</joint>

<joint name="plate_to_cobot_mount" type="fixed">
    <parent link="plate"/>
    <child link="cobot_mount"/>
    <origin xyz="0.3 0 0.012" rpy="0 0 3.14159"/>
</joint>

<!-- Target frames: parented to their object so they follow it if it moves.
     Measured from the object's center frame, so z = +half height = top surface. -->
<joint name="insert_fixture_to_insert_target" type="fixed">
    <parent link="insert_fixture"/>
    <child link="insert_target"/>
    <origin xyz="0 0 0.015" rpy="0 0 0"/>
</joint>

<joint name="insert_tray_to_insert_pick" type="fixed">
    <parent link="insert_tray"/>
    <child link="insert_pick"/>
    <origin xyz="0 0 0.0075" rpy="0 0 0"/>
</joint>

<joint name="toolChangerDock_to_tool_slot_1" type="fixed">
    <parent link="toolChangerDock"/>
    <child link="tool_slot_1"/>
    <origin xyz="-0.05 0 0.05" rpy="0 0 0"/>
</joint>

<joint name="toolChangerDock_to_tool_slot_2" type="fixed">
    <parent link="toolChangerDock"/>
    <child link="tool_slot_2"/>
    <origin xyz="0.05 0 0.05" rpy="0 0 0"/>
</joint>

</robot>
