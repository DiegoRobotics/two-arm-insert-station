<?xml version="1.0"?>
<package format="3">
  <name>ar4tc_toolchanger</name>
  <version>0.1.0</version>
  <description>AR4 MK3 simulated tool changer: kinematics validation, MoveIt motion, tool-change state machine.</description>
  <maintainer email="gael10838@gmail.com">gael</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>annin_ar4_description</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>pinocchio</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>annin_ar4_moveit_config</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>xacro</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
